# WiFi 配置
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_SSID="ECG-Physio"
CONFIG_ESP_WIFI_PASSWORD=""
CONFIG_ESP_WIFI_CHANNEL=6
CONFIG_ESP_WIFI_MAX_CONNECTIONS=4

# LWIP 配置
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_SO_RCVBUF=y

# FreeRTOS 配置
CONFIG_FREERTOS_HZ=1000

# 日志配置
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ECG WiFi Bridge 配置
CONFIG_ECG_WIFI_SSID="ECG-Physio"
CONFIG_ECG_WIFI_PASSWORD=""
CONFIG_ECG_WIFI_CHANNEL=6
CONFIG_ECG_TCP_PORT=12345
CONFIG_ECG_DATA_MODE=1
CONFIG_ECG_FRAME_RATE=125
CONFIG_ECG_UART_BAUD=819200